# Servidor Express
PORT=3001
NODE_ENV=development

# Autenticação JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Servidor Python AI
PYTHON_PORT=3002
AI_API_KEY=

# Modelo de IA local (phi3.5-mini, llama3.2-3b, gemma2-2b, tinyllama-1.1b)
AI_MODEL=phi3.5-mini
# MODEL_PATH=models/Phi-3.5-Mini-Instruct.Q4_K_M.gguf

# Ollama (se disponível)
# OLLAMA_MODEL=phi3.5:3.8b
# OLLAMA_TIMEOUT=60

# CORS
FRONTEND_URL=http://localhost:3000

# Rede / Tunnel
ALLOWED_CLIENT_IPS=192.168.0.0/16,10.0.0.0/8,127.0.0.1

# Atualizações
UPDATE_HASH=

# Integridade do Instalador de Python (bootstrap do pip)
EXPECTED_GETPIP_SHA256=a341e1a43e38001c551a1508a73ff23636a11970b61d901d9a1cad2a18f57055
