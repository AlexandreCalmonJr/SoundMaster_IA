{
  "name": "soundmaster",
  "version": "1.2.0",
  "description": "SoundMaster Pro - Ecossistema inteligente de controle e análise de áudio para técnicos de som de igreja e eventos.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:worklets": "node scripts/build-worklets.js",
    "build": "npm run build:worklets && npm run build:css",
    "build:css": "tailwindcss -i frontend/css/input.css -o frontend/css/styles.css",
    "dev:css": "tailwindcss -i frontend/css/input.css -o frontend/css/styles.css --watch",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "prepare-wincodesign": "node scripts/prepare-wincodesign.js",
    "postinstall": "node scripts/install-python-deps.js && electron-rebuild -f -w better-sqlite3",
    "test": "vitest run",
    "pretest": "npm rebuild better-sqlite3 --runtime=node --update-binary",
    "prestart": "electron-rebuild -f -w better-sqlite3",
    "testbed": "node tests/testbed.js",
    "audit": "vitest run tests/audit.test.js",
    "audit:quick": "echo 'Use: npm run audit para rodar auditoria completa' && echo 'Abra AUDIT_INTERACTIVE.html para teste visual interativo' && echo 'Consulte AUDIT_GUIDE.md para instruções detalhadas'"
  },
  "build": {
    "appId": "com.soundmaster.app",
    "productName": "SoundMaster",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "docs/",
        "to": "docs/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/",
        "to": "scripts/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/ai/",
        "to": "backend/ai/",
        "filter": [
          "**/*",
          "!.git"
        ]
      }
    ]
  },
  "keywords": [],
  "author": "Alexandre Calmon Jr. <alexandre@soundmaster.app>",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "adm-zip": "^0.5.17",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "multicast-dns": "^7.2.5",
    "osc": "^2.4.2",
    "socket.io": "^4.8.3",
    "soundcraft-ui-connection": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/cli": "^4.2.4",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.2.4",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
